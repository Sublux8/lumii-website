# security.txt and well-known served as text.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Sveltia CMS admin — its OWN relaxed CSP (the only CSP rule matching /admin).
# Loads the CMS bundle from unpkg, talks to GitHub + the OAuth relay.
/admin/*
