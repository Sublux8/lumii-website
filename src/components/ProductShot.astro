---
/**
 * Screenshot-ready product surface. Until a real capture is supplied it renders
 * a polished, code-native composition that communicates the intended framing.
 * Supplying `src` swaps the placeholder for the real product without changing
 * the surrounding page layout.
 */
interface Props {
  shotId: string;
  title: string;
  note?: string;
  src?: string;
  alt?: string;
  device?: "desktop" | "phone" | "tablet";
  variant?: "calendar" | "care" | "vitality" | "health" | "insights";
  class?: string;
}

const {
  shotId,
  title,
  note,
  src,
  alt = title,
  device = "desktop",
  variant = "calendar",
  class: className,
} = Astro.props;
---

<figure
  class:list={["product-shot", `product-shot--${device}`, `is-${variant}`, className]}
  data-shot-id={shotId}
>
  <div class="product-shot__frame">
    {
      device !== "phone" && (
        <div class="product-shot__chrome" aria-hidden="true">
          <span>
            <>
              <i />
              <i />
              <i />
            </>
          </span>
          <small>Lumii</small>
        </div>
      )
    }

    {
      src ? (
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <div
          class="product-shot__placeholder"
          aria-label={`Screenshot placeholder: ${title}`}
        >
          {device === "phone" && (
            <div class="product-shot__phonebar" aria-hidden="true">
              <span>9:41</span>
              <i />
            </div>
          )}

          <div class="product-shot__mock" aria-hidden="true">
            <aside>
              <>
                <b>L</b>
                <i />
                <i />
                <i />
                <i />
              </>
            </aside>
            <main>
              <header>
                <>
                  <span />
                  <i />
                </>
              </header>
              <div class="mock-calendar">
                <span class="mock-calendar__time" />
                <span class="mock-calendar__event e1" />
                <span class="mock-calendar__event e2" />
                <span class="mock-calendar__event e3" />
                <span class="mock-calendar__event e4" />
              </div>
              <div class="mock-list">
                <span>
                  <>
                    <i />
                    <b />
                    <small />
                  </>
                </span>
                <span>
                  <>
                    <i />
                    <b />
                    <small />
                  </>
                </span>
                <span>
                  <>
                    <i />
                    <b />
                    <small />
                  </>
                </span>
              </div>
              <div class="mock-vitality">
                <span>
                  <b>82</b>
                </span>
                <div>
                  <>
                    <i />
                    <i />
                    <i />
                  </>
                </div>
              </div>
              <div class="mock-health">
                <>
                  <span>
                    <>
                      <b />
                      <i />
                    </>
                  </span>
                  <span>
                    <>
                      <b />
                      <i />
                    </>
                  </span>
                </>
                <>
                  <span>
                    <>
                      <b />
                      <i />
                    </>
                  </span>
                  <span>
                    <>
                      <b />
                      <i />
                    </>
                  </span>
                </>
              </div>
              <div class="mock-insights">
                <>
                  <span />
                  <strong />
                  <i />
                  <i />
                  <i />
                </>
              </div>
            </main>
          </div>

          <span class="product-shot__badge">Screenshot {shotId}</span>
        </div>
      )
    }
  </div>
  <figcaption>
    <strong>{title}</strong>
    {note && <span>{note}</span>}
  </figcaption>
</figure>

<style>
  .product-shot {
    margin: 0;
    inline-size: 100%;
  }
  .product-shot__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    border-radius: 1.4rem;
    background: #fffdf8;
    box-shadow: 0 1.7rem 4rem color-mix(in srgb, var(--text) 14%, transparent);
  }
  .product-shot--desktop .product-shot__frame {
    aspect-ratio: 16 / 10;
  }
  .product-shot--tablet .product-shot__frame {
    aspect-ratio: 4 / 3;
  }
  .product-shot--phone {
    max-inline-size: 18rem;
  }
  .product-shot--phone .product-shot__frame {
    aspect-ratio: 9 / 18.6;
    border: 7px solid #17302d;
    border-radius: 2.4rem;
    box-shadow: 0 1.8rem 4rem rgba(20, 45, 43, 0.19);
  }
  .product-shot__chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    block-size: 2.45rem;
    padding-inline: 0.9rem;
    border-block-end: 1px solid #ece3d6;
    background: #faf6ef;
  }
  .product-shot__chrome > span {
    display: flex;
    gap: 0.35rem;
  }
  .product-shot__chrome i {
    inline-size: 0.58rem;
    block-size: 0.58rem;
    border-radius: 50%;
    background: var(--brand-warmth);
  }
  .product-shot__chrome i:nth-child(2) {
    background: var(--brand-gold);
  }
  .product-shot__chrome i:nth-child(3) {
    background: #79c8b9;
  }
  .product-shot__chrome small {
    color: #75827f;
    font-size: 0.65rem;
    font-weight: 700;
  }
  .product-shot__frame > img {
    inline-size: 100%;
    block-size: calc(100% - 2.45rem);
    object-fit: cover;
    object-position: top center;
  }
  .product-shot--phone .product-shot__frame > img {
    block-size: 100%;
  }
  .product-shot__placeholder {
    position: relative;
    block-size: calc(100% - 2.45rem);
    background:
      radial-gradient(circle at 88% 12%, rgba(238, 182, 165, 0.2), transparent 28%),
      linear-gradient(145deg, #fbf8f1, #eff6f2);
  }
  .product-shot--phone .product-shot__placeholder {
    block-size: 100%;
  }
  .product-shot__phonebar {
    position: absolute;
    z-index: 3;
    inset-block-start: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: 2.2rem;
    padding-inline: 1rem;
    color: #405b57;
    font-size: 0.58rem;
    font-weight: 800;
  }
  .product-shot__phonebar i {
    inline-size: 3rem;
    block-size: 0.9rem;
    border-radius: 99px;
    background: #17302d;
  }
  .product-shot__mock {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    block-size: 100%;
  }
  .product-shot--phone .product-shot__mock {
    display: block;
    padding: 2.7rem 0.9rem 1rem;
  }
  .product-shot__mock aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.8rem;
    border-inline-end: 1px solid #e6ece8;
    background: rgba(255, 255, 255, 0.56);
  }
  .product-shot--phone .product-shot__mock aside {
    display: none;
  }
  .product-shot__mock aside b {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 0.68rem;
    background: var(--accent);
    color: white;
    font-family: var(--font-display);
  }
  .product-shot__mock aside i {
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border-radius: 0.55rem;
    background: #dcebe6;
  }
  .product-shot__mock main {
    padding: clamp(0.85rem, 2.6vw, 1.55rem);
  }
  .product-shot__mock header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 1rem;
  }
  .product-shot__mock header span {
    inline-size: 36%;
    block-size: 0.9rem;
    border-radius: 99px;
    background: #274743;
  }
  .product-shot__mock header i {
    inline-size: 4.5rem;
    block-size: 1.8rem;
    border-radius: 99px;
    background: var(--accent);
  }
  .product-shot--phone .product-shot__mock header span {
    inline-size: 54%;
  }
  .product-shot--phone .product-shot__mock header i {
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    background: #f0d77e;
  }
  .mock-calendar {
    position: relative;
    min-block-size: 15rem;
    border: 1px solid #dfe8e4;
    border-radius: 1rem;
    background:
      repeating-linear-gradient(to bottom, transparent 0 2.35rem, #e3ebe7 2.35rem 2.4rem),
      repeating-linear-gradient(to right, transparent 0 32%, #e3ebe7 32% 32.3%);
  }
  .mock-calendar__event {
    position: absolute;
    block-size: 2.7rem;
    border-inline-start: 3px solid var(--accent);
    border-radius: 0.55rem;
    background: #dcefe9;
  }
  .mock-calendar__event::after {
    content: "";
    display: block;
    inline-size: 58%;
    block-size: 0.35rem;
    margin: 0.7rem;
    border-radius: 99px;
    background: #74afa4;
  }
  .mock-calendar__event.e1 {
    inset: 1.2rem auto auto 4%;
    inline-size: 26%;
  }
  .mock-calendar__event.e2 {
    inset: 4.1rem auto auto 36%;
    inline-size: 27%;
    background: #fae9d5;
    border-color: #d79455;
  }
  .mock-calendar__event.e3 {
    inset: 7.2rem 3% auto auto;
    inline-size: 28%;
    background: #ebe9f8;
    border-color: #8b82bf;
  }
  .mock-calendar__event.e4 {
    inset: 10.8rem auto auto 5%;
    inline-size: 57%;
  }
  .mock-list,
  .mock-vitality,
  .mock-health,
  .mock-insights {
    display: none;
  }
  .is-care .mock-calendar,
  .is-vitality .mock-calendar,
  .is-health .mock-calendar,
  .is-insights .mock-calendar {
    display: none;
  }
  .is-care .mock-list {
    display: grid;
    gap: 0.7rem;
  }
  .mock-list > span {
    display: grid;
    grid-template-columns: 2.3rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    min-block-size: 4.6rem;
    padding: 0.75rem;
    border: 1px solid #e0e8e4;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.7);
  }
  .mock-list > span i {
    inline-size: 2.2rem;
    block-size: 2.2rem;
    border-radius: 0.7rem;
    background: #dcefe9;
  }
  .mock-list > span b {
    inline-size: 64%;
    block-size: 0.48rem;
    border-radius: 99px;
    background: #56706b;
  }
  .mock-list > span small {
    inline-size: 3.3rem;
    block-size: 1.1rem;
    border-radius: 99px;
    background: #f5e2b7;
  }
  .is-vitality .mock-vitality {
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    padding-block: 0.5rem;
  }
  .mock-vitality > span {
    display: grid;
    place-items: center;
    inline-size: 7.5rem;
    block-size: 7.5rem;
    border: 0.85rem solid #7ac3b5;
    border-inline-end-color: #e9d172;
    border-radius: 50%;
  }
  .mock-vitality > span b {
    color: #21413d;
    font-family: var(--font-display);
    font-size: 2.2rem;
  }
  .mock-vitality > div {
    display: grid;
    gap: 0.8rem;
    inline-size: 100%;
  }
  .mock-vitality > div i {
    block-size: 0.62rem;
    border-radius: 99px;
    background: linear-gradient(90deg, #62b5a5 74%, #dce9e5 74%);
  }
  .mock-vitality > div i:nth-child(2) {
    background: linear-gradient(90deg, #dfaf93 62%, #dce9e5 62%);
  }
  .mock-vitality > div i:nth-child(3) {
    background: linear-gradient(90deg, #8f8bc5 81%, #dce9e5 81%);
  }
  .is-health .mock-health {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }
  .mock-health > span {
    min-block-size: 6.5rem;
    padding: 0.8rem;
    border: 1px solid #dfe8e4;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.7);
  }
  .mock-health b {
    display: block;
    inline-size: 42%;
    block-size: 0.5rem;
    border-radius: 99px;
    background: #71847f;
  }
  .mock-health i {
    display: block;
    inline-size: 76%;
    block-size: 2.6rem;
    margin-block-start: 1rem;
    border-block-end: 2px solid #64ad9f;
    border-radius: 50%;
    transform: skewY(-10deg);
  }
  .is-insights .mock-insights {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid #e0e8e4;
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.7);
  }
  .mock-insights span {
    inline-size: 4.5rem;
    block-size: 1.2rem;
    border-radius: 99px;
    background: #e8e4f7;
  }
  .mock-insights strong {
    inline-size: 75%;
    block-size: 0.8rem;
    border-radius: 99px;
    background: #274743;
  }
  .mock-insights i {
    block-size: 0.42rem;
    border-radius: 99px;
    background: #ccd9d5;
  }
  .mock-insights i:nth-last-child(1) {
    inline-size: 62%;
  }
  .product-shot__badge {
    position: absolute;
    inset-inline-end: 0.8rem;
    inset-block-end: 0.8rem;
    padding: 0.38rem 0.58rem;
    border: 1px solid rgba(20, 45, 43, 0.11);
    border-radius: 99px;
    background: rgba(255, 253, 248, 0.88);
    color: #526b66;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }
  .product-shot figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-block-start: 0.85rem;
  }
  .product-shot figcaption strong {
    color: var(--text);
    font-family: var(--font-sans);
    font-size: var(--text-subhead);
    font-weight: var(--weight-semibold);
  }
  .product-shot figcaption span {
    color: var(--text-muted);
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
  }
  @media (max-width: 36rem) {
    .product-shot--phone {
      max-inline-size: 15rem;
    }
    .product-shot__badge {
      font-size: 0.5rem;
    }
  }
</style>
