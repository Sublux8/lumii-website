---
/**
 * Inline line-icon set. 24×24, stroke = `currentColor` so an icon inherits the
 * surrounding colour (e.g. the white `on-accent` inside FeatureBlock's gradient
 * chip, or a token colour anywhere else). Curated to the marks the site actually
 * uses — feature modules + sector audiences — with a sparkle fallback so an
 * unknown name never renders a broken box.
 *
 * Names map to features (frontdesk, claim, careplan, telehealth, xero, analytics,
 * shield, au, update, lock) and sector ids (allied-health, general-practice,
 * public-health, academic-research).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className } = Astro.props;

const ICONS: Record<string, string> = {
  frontdesk: `<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 3v3M16 3v3"/><path d="M8.5 14.5l2 2 4-4"/>`,
  claim: `<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19M6 15h4"/>`,
  careplan: `<rect x="5" y="5" width="14" height="16" rx="2.5"/><rect x="9" y="3" width="6" height="3.6" rx="1.3"/><path d="M8.6 13.6l2 2 4-4"/>`,
  telehealth: `<rect x="2.5" y="6" width="13" height="12" rx="2.5"/><path d="M15.5 10l6-3.5v11l-6-3.5z"/>`,
  xero: `<path d="M20 11a8 8 0 0 0-14-5M4 6v4h4"/><path d="M4 13a8 8 0 0 0 14 5M20 18v-4h-4"/>`,
  analytics: `<path d="M3 20.5h18"/><path d="M6.5 20.5v-6M11.5 20.5V8M16.5 20.5v-9"/>`,
  shield: `<path d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6z"/><path d="M9 12l2 2 4-4"/>`,
  au: `<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>`,
  update: `<path d="M12 3v12M7 11l5 5 5-5"/><path d="M5 20.5h14"/>`,
  lock: `<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/><path d="M12 14.5v3"/>`,
  medicare: `<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M7 12.5h3M8.5 11v3"/><path d="M14 11.5h4M14 14.5h3"/>`,
  notes: `<path d="M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v4h4M9 12h6M9 16h5M9 8h2"/>`,
  registry: `<rect x="3.5" y="4" width="17" height="16" rx="2.5"/><path d="M8 9h8M8 12h8M8 15h5"/><path d="M5.5 9h.01M5.5 12h.01M5.5 15h.01"/>`,
  layers: `<path d="M12 3l8.5 4.5L12 12 3.5 7.5z"/><path d="M3.5 12L12 16.5 20.5 12M3.5 16.5L12 21l8.5-4.5"/>`,
  mfa: `<circle cx="6.5" cy="12" r="3.5"/><path d="M10 12h10.5M17.5 12v3M20.5 12v2.5"/>`,
  backup: `<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>`,
  book: `<path d="M12 6.5C10.5 5 8 4.5 4.5 4.5V18C8 18 10.5 18.5 12 20M12 6.5C13.5 5 16 4.5 19.5 4.5V18C16 18 13.5 18.5 12 20M12 6.5V20"/>`,
  "allied-health": `<path d="M3 12.5h4l2.4 6.5 5-14L17 12.5h4"/>`,
  "general-practice": `<circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/>`,
  "public-health": `<circle cx="9" cy="9" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><path d="M15.8 6.4a3 3 0 0 1 0 5.6M16.5 19a5.6 5.6 0 0 0-1.8-4.1"/>`,
  "academic-research": `<path d="M9 3h6M10 3v5.8l-4.4 8a2 2 0 0 0 1.8 3h9.2a2 2 0 0 0 1.8-3L14 8.8V3"/><path d="M7.6 15h8.8"/>`,
};

const SPARKLE = `<path d="M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6z"/>`;
const inner = ICONS[name] ?? SPARKLE;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
