---
/**
 * Site footer. Link columns + the Australian data-residency note (a deliberate
 * trust signal) + security.txt link. All copy from the catalogue.
 */
import { useTranslations, localizePath } from "@i18n/index.ts";

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
const year = new Date().getFullYear();

const columns = [
  {
    heading: t("footer.product"),
    links: [
      { href: "/sectors", label: t("nav.sectors") },
      { href: "/platform", label: t("nav.platform") },
      { href: "/for-clinicians", label: t("nav.forClinicians") },
      { href: "/pricing", label: t("nav.pricing") },
    ],
  },
  {
    heading: t("footer.resources"),
    links: [{ href: "/knowledge", label: t("nav.knowledge") }],
  },
  {
    heading: t("footer.company"),
    links: [
      { href: "/about", label: t("nav.about") },
      { href: "mailto:support@lumii.com.au", label: t("footer.contact") },
    ],
  },
  {
    heading: t("footer.legal"),
    links: [
      { href: "/privacy", label: t("footer.privacy") },
      { href: "/security", label: t("footer.security") },
      { href: "/terms", label: t("footer.terms") },
    ],
  },
];
---

<footer class="footer">
  <div class="container-page footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={lp("/")}>
        <img
          class="footer__logo-img"
          src="/logo.svg"
          alt={t("site.name")}
          width="92"
          height="33"
        />
      </a>
      <p class="footer__residency">{t("footer.residency")}</p>
    </div>

    <nav class="footer__cols" aria-label={t("footer.company")}>
      {
        columns.map((col) => (
          <div class="footer__col">
            <h2 class="footer__heading">{col.heading}</h2>
            <ul class="footer__list">
              {col.links.map((l) => (
                <li>
                  <a
                    class="footer__link"
                    href={l.href.startsWith("/") ? lp(l.href) : l.href}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container-page footer__base">
    <p>&copy; {year} {t("site.name")}. {t("footer.rights")}</p>
    <a class="footer__link" href="/.well-known/security.txt">security.txt</a>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-section);
    padding-block: var(--space-4xl) var(--space-xl);
    background-color: var(--surface);
    border-block-start: var(--border-hairline) solid
      color-mix(in srgb, var(--border) 50%, transparent);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 3fr;
    gap: var(--space-3xl);
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .footer__logo-img {
    block-size: 2rem;
    inline-size: auto;
    display: block;
  }
  :root[data-theme="dark"] .footer__logo-img {
    filter: brightness(0) invert(1);
  }
  .footer__residency {
    margin-block-start: var(--space-md);
    max-inline-size: 28ch;
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }
  .footer__heading {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-end: var(--space-md);
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .footer__link {
    font-size: var(--text-subhead);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .footer__link:hover {
    color: var(--text);
  }
  .footer__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-lg);
    border-block-start: var(--border-hairline) solid
      color-mix(in srgb, var(--border) 40%, transparent);
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
  @media (max-width: 52rem) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .footer__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
