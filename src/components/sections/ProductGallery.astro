---
/**
 * Screenshot-ready clinic gallery. ProductShot keeps the finished layout intact
 * while the labelled compositions are replaced with approved product captures.
 */
import ProductShot from "@components/ProductShot.astro";
---

<section class="gallery container-page section">
  <header class="section__head" data-reveal>
    <p class="section__eyebrow">Lumii, on screen</p>
    <h2>The information your team needs, clearly presented.</h2>
    <p class="section__lead measure">
      Move from the appointment book to billing and funded care without piecing the story
      together again. Lumii keeps the next useful thing close at hand.
    </p>
  </header>

  <ProductShot
    shotId="C01"
    title="See the whole clinic day clearly"
    note="Every practitioner, appointment and arrival in one easy-to-read day."
    src="/product/lumii-clinic-day.webp"
    alt="Lumii appointment book showing a populated clinic day across Jess Allen, Aisha Malik, Dr Maya Rao and Sam Tukimoto"
    device="wide"
    aspectRatio="2005 / 750"
    showChrome={false}
    variant="calendar"
    class="gallery__hero"
  />

  <div class="gallery__row">
    <ProductShot
      shotId="C02"
      title="See what needs attention before it becomes a problem"
      note="Claims, outstanding balances and funder payments, clearly prioritised for the team."
      src="/product/lumii-claims.webp"
      alt="Lumii billing command centre showing claiming queues, payer exposure, account hotlist and funder balances"
      device="wide"
      aspectRatio="3440 / 1255"
      showChrome={false}
      variant="care"
      class="gallery__claims"
    />
    <ProductShot
      shotId="C03"
      title="Know what is left before the patient has to ask"
      note="See sessions used, visits remaining and upcoming expiry dates in one view."
      src="/product/lumii-care-plan.webp"
      alt="Lumii care plans management showing active Medicare, DVA and Comcare plans with session usage and expiry dates"
      device="wide"
      aspectRatio="1707 / 752"
      showChrome={false}
      variant="care"
      class="gallery__care"
    />
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--space-section);
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46rem;
  }
  .section__eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--accent);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .section__lead {
    margin-block-start: var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-lead);
  }
  :global(.gallery__hero) {
    max-inline-size: 76rem;
    margin-inline: auto;
  }
  .gallery__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    max-inline-size: 76rem;
    margin: var(--space-2xl) auto 0;
  }
  :global(.gallery__claims) {
    grid-column: 1 / -1;
  }
  :global(.gallery__care) {
    grid-column: 1 / -1;
    inline-size: 100%;
    justify-self: center;
  }
  @media (max-width: 44rem) {
    .gallery__row {
      grid-template-columns: 1fr;
    }
  }
</style>
