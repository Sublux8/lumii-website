---
/**
 * Screenshot-ready clinic gallery. ProductShot keeps the finished layout intact
 * while the labelled compositions are replaced with approved product captures.
 */
import ProductShot from "@components/ProductShot.astro";
---

<section class="gallery container-page section">
  <header class="section__head" data-reveal>
    <p class="section__eyebrow">Lumii, on screen</p>
    <h2>A workspace that feels as calm as it looks.</h2>
    <p class="section__lead measure">
      The day’s book, claiming and funded care stay close together. These frames are ready
      for the real product captures that will take the website from polished to
      unmistakably Lumii.
    </p>
  </header>

  <ProductShot
    shotId="C01"
    title="The clinic day at a glance"
    note="Full-day appointment book across three or more practitioners, using fictional demo patients."
    variant="calendar"
    class="gallery__hero"
  />

  <div class="gallery__row">
    <ProductShot
      shotId="C02"
      title="Claims without the chase"
      note="A populated claiming queue with several funders, statuses and demo amounts."
      variant="care"
    />
    <ProductShot
      shotId="C03"
      title="Funded care that keeps count"
      note="A care-plan detail showing sessions used, referral validity and the next review."
      device="tablet"
      variant="care"
    />
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--space-section);
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46rem;
  }
  .section__eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--accent);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .section__lead {
    margin-block-start: var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-lead);
  }
  .gallery__hero {
    max-inline-size: 65rem;
    margin-inline: auto;
  }
  .gallery__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    max-inline-size: 65rem;
    margin: var(--space-2xl) auto 0;
  }
  @media (max-width: 44rem) {
    .gallery__row {
      grid-template-columns: 1fr;
    }
  }
</style>
