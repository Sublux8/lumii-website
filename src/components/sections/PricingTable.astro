---
/**
 * Pricing table. Tiers passed in; one can be `featured`. Pre-launch the numbers
 * aren't set, so pages can render placeholder tiers — the structure is what's
 * being proven here. Prices should be formatted by the caller via formatCurrency
 * so they stay locale-aware (§4).
 */
import Button from "@components/primitives/Button.astro";
import Badge from "@components/primitives/Badge.astro";

interface Tier {
  name: string;
  price: string;
  cadence?: string;
  description: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  featured?: boolean;
  badge?: string;
}
interface Props {
  tiers: Tier[];
}
const { tiers } = Astro.props;
---

<section class="pricing container-page">
  <div class="pricing__grid">
    {
      tiers.map((tier) => (
        <article
          class={["tier", tier.featured && "tier--featured"].filter(Boolean).join(" ")}
        >
          {tier.badge && (
            <div class="tier__badge">
              <Badge tone="green">{tier.badge}</Badge>
            </div>
          )}
          <h3 class="tier__name">{tier.name}</h3>
          <p class="tier__price">
            <span class="tier__amount">{tier.price}</span>
            {tier.cadence && <span class="tier__cadence">{tier.cadence}</span>}
          </p>
          <p class="tier__desc">{tier.description}</p>
          <ul class="tier__features">
            {tier.features.map((f) => (
              <li class="tier__feature">{f}</li>
            ))}
          </ul>
          <Button
            href={tier.ctaHref}
            variant={tier.featured ? "primary" : "ghost"}
            size="md"
            id={`pricing-${tier.name}`}
            class="tier__cta"
          >
            {tier.ctaLabel}
          </Button>
        </article>
      ))
    }
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--space-section);
  }
  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-xl);
    align-items: start;
  }
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl);
    background-color: var(--surface);
    border: var(--border-width) solid color-mix(in srgb, var(--border) 55%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
  }
  .tier--featured {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: var(--shadow-card);
  }
  .tier__badge {
    position: absolute;
    inset-block-start: var(--space-md);
    inset-inline-end: var(--space-md);
  }
  .tier__name {
    font-size: var(--text-h4);
  }
  .tier__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }
  .tier__amount {
    font-family: var(--font-mono);
    font-size: var(--text-display);
    font-weight: var(--weight-bold);
    color: var(--text);
  }
  .tier__cadence {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
  .tier__desc {
    font-size: var(--text-body);
    color: var(--text-secondary);
  }
  .tier__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .tier__feature {
    position: relative;
    padding-inline-start: var(--space-lg);
    font-size: var(--text-body);
    color: var(--text-secondary);
  }
  .tier__feature::before {
    content: "✓";
    position: absolute;
    inset-inline-start: 0;
    color: var(--success);
    font-weight: var(--weight-bold);
  }
  .tier__cta {
    margin-block-start: auto;
  }
</style>
