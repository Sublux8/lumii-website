---
/**
 * Downloads page (/[locale]/download) — the human-facing "get the Mac app" page.
 * The actual binary + Sparkle appcast live on download.lumii.com.au (file host);
 * this page just points humans at the latest release. Release metadata comes
 * from the single bump-point in src/data/release.ts.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/primitives/Button.astro";
import FeatureBlock from "@components/sections/FeatureBlock.astro";
import CTA from "@components/sections/CTA.astro";
import {
  useTranslations,
  localeFromPath,
  localizePath,
  localeStaticPaths,
  formatDate,
  getLocale,
} from "@i18n/index.ts";
import { macRelease, formatBytes } from "@/data/release.ts";

export function getStaticPaths() {
  return localeStaticPaths();
}

const localePath = localeFromPath(Astro.url.pathname);
const locale = getLocale(localePath);
const t = useTranslations(localePath);
const lp = (p: string) => localizePath(p, localePath);

const released = formatDate(new Date(macRelease.releasedISO), locale, {
  dateStyle: "long",
});

const features = [
  {
    title: t("download.autoUpdateTitle"),
    body: t("download.autoUpdate"),
    icon: "update",
  },
  { title: t("download.securityTitle"), body: t("download.security"), icon: "shield" },
  { title: t("download.residencyTitle"), body: t("download.residency"), icon: "au" },
];
---

<BaseLayout title={t("download.title")} description={t("download.subtitle")}>
  <section class="dl container-page">
    <div class="dl__aurora" aria-hidden="true"></div>
    <div class="dl__inner">
      <p class="dl__eyebrow">macOS</p>
      <h1 class="dl__title">{t("download.title")}</h1>
      <p class="dl__subtitle measure">{t("download.subtitle")}</p>

      <div class="dl__actions">
        <Button href={macRelease.url} size="lg" id="download-macos">
          {t("download.cta")}
        </Button>
        <p class="dl__meta">
          <span>{t("download.version", { version: macRelease.version })}</span>
          <span aria-hidden="true">·</span>
          <span>
            {
              t("download.requirements", {
                minMacOS: macRelease.minMacOS,
                size: formatBytes(macRelease.bytes),
              })
            }
          </span>
          <span aria-hidden="true">·</span>
          <span>{t("download.released", { date: released })}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="container-page grid-3">
    {features.map((f) => <FeatureBlock title={f.title} body={f.body} icon={f.icon} />)}
  </section>

  <section class="container-page note">
    <p class="measure">{t("download.otherPlatforms")}</p>
  </section>

  <CTA
    title={t("cta.title")}
    body={t("cta.body")}
    buttonLabel={t("cta.button")}
    buttonHref={lp("/request-access")}
  />
</BaseLayout>

<style>
  .dl {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) var(--space-2xl);
  }
  .dl__aurora {
    position: absolute;
    inset-block-start: -35%;
    inset-inline-end: -10%;
    inline-size: 55vw;
    block-size: 55vw;
    max-inline-size: 640px;
    max-block-size: 640px;
    background-image: var(--gradient-aurora);
    filter: blur(60px);
    opacity: 0.7;
    pointer-events: none;
  }
  .dl__inner {
    position: relative;
    z-index: var(--z-raised);
  }
  .dl__eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-md);
  }
  .dl__title {
    font-size: var(--text-h1);
    max-inline-size: 16ch;
  }
  .dl__subtitle {
    margin-block-start: var(--space-lg);
    font-size: var(--text-lead);
    color: var(--text-secondary);
  }
  .dl__actions {
    margin-block-start: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: start;
  }
  .dl__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }
  .note {
    padding-block: var(--space-lg) var(--space-2xl);
    color: var(--text-secondary);
  }
</style>
