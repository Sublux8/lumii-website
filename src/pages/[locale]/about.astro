---
/**
 * About — the story + values page. Carries the brand voice most directly: warm,
 * Australian, human ("on your side"). Values render as icon cards; the closing
 * narrative sets the pre-launch, foundation-clinic posture.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import FeatureBlock from "@components/sections/FeatureBlock.astro";
import CTA from "@components/sections/CTA.astro";
import {
  useTranslations,
  localeFromPath,
  localizePath,
  localeStaticPaths,
} from "@i18n/index.ts";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);

const beliefs = [
  {
    title: "Calm beats clever",
    body: "The best software disappears. Lumii is built to get out of the way — fewer clicks, fewer systems, fewer surprises — so your team can spend their attention on people, not screens.",
    icon: "spark",
  },
  {
    title: "Australian, properly",
    body: "Tyro, Medicare, NDIS, DVA, and patient data kept in Sydney. Not a global product with a local plug-in — built from the ground up for how clinics here actually book, bill and get paid.",
    icon: "au",
  },
  {
    title: "Made for different kinds of care",
    body: "Allied health, general practice, medical specialists, aged care and NDIS. Lumii adapts to your team and funding mix instead of forcing every clinic into the same mould.",
    icon: "layers",
  },
  {
    title: "Your data is yours",
    body: "Stored in Australia, encrypted, with you in control. We hold it carefully because it's the most trust a clinic can give us — and we'd rather earn that than assume it.",
    icon: "lock",
  },
  {
    title: "Care has two sides",
    body: "Lumii helps the clinic run the day; myLumii helps the person carry care between visits. We design both experiences as one conversation, with consent at the bridge between them.",
    icon: "layers",
  },
];
---

<BaseLayout
  title={t("nav.about")}
  description="Lumii is Australian-built care technology for practices and people—bringing the clinical day, connected care and personal health into a calmer experience."
>
  <Hero
    eyebrow="About Lumii"
    title="Care technology that feels like it is on your side."
    subtitle="Lumii is made in Australia for practices and people: less friction in the clinical day, health information kept close to home and an experience that feels genuinely good to use."
    primaryLabel={t("hero.ctaPrimary")}
    primaryHref={lp("/request-access")}
    secondaryLabel={t("nav.platform")}
    secondaryHref={lp("/platform")}
  />

  <section class="container-page section">
    <header class="section__head">
      <p class="section__eyebrow">What we believe</p>
      <h2>A few things we won't compromise on.</h2>
    </header>
    <div class="grid-2">
      {beliefs.map((b) => <FeatureBlock title={b.title} body={b.body} icon={b.icon} />)}
    </div>
  </section>

  <section class="container-page section section--tight">
    <div class="story measure">
      <p class="section__eyebrow">How we're introducing Lumii</p>
      <h2>Built closely with the people who will use it.</h2>
      <p>
        Lumii is welcoming a small number of practices at a time. That gives every team
        real help with moving data, setting up and finding their feet, while giving us time
        to listen carefully and respond well.
      </p>
      <p>
        The people shaping Lumii stay close to the people using it. If you run a practice,
        work in care or simply know that health technology can feel better than it does
        today, we genuinely want to hear what would make the difference.
      </p>
      <p>
        It also means building for the person beyond the waiting room. myLumii is being
        prepared alongside Lumii so appointments, shared records, forms,
        messages and rehabilitation can feel like one continuous care story—not a trail of
        portals and paperwork.
      </p>
    </div>
  </section>

  <CTA
    eyebrow="Start a conversation"
    title="Help us make care technology feel more human."
    body="Tell us whether Lumii has caught your eye for your practice, your work or your own health. We'd love to hear your perspective."
    buttonLabel={t("cta.button")}
    buttonHref={lp("/request-access")}
  />
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-section);
  }
  .section--tight {
    padding-block-start: 0;
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46ch;
  }
  .section__eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-xl);
  }
  .story h2 {
    font-size: var(--text-h2);
    margin-block: var(--space-sm) var(--space-lg);
  }
  .story p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-lg);
  }
</style>
