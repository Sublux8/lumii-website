---
/**
 * Sector landing page — generated from each published/draft `sectors` entry.
 * Reserved sectors are excluded from getStaticPaths (no route). Draft sectors
 * build but are noindex so they're reviewable by URL without being indexed.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import FeatureBlock from "@components/sections/FeatureBlock.astro";
import Badge from "@components/primitives/Badge.astro";
import CTA from "@components/sections/CTA.astro";
import { useTranslations, localeFromPath, localizePath } from "@i18n/index.ts";
import { LOCALES } from "@i18n/config.ts";

export async function getStaticPaths() {
  const sectors = await getCollection("sectors", (s) => s.data.status !== "reserved");
  // One page per (locale, sector) — reserved sectors excluded, all locales built.
  return LOCALES.flatMap((l) =>
    sectors.map((sector) => ({
      params: { locale: l.path, sector: sector.id },
      props: { sector },
    })),
  );
}

const { sector } = Astro.props;
const { data } = sector;
const { Content } = await render(sector);

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
---

<BaseLayout
  title={data.seo?.title ?? data.audience}
  description={data.seo?.description ?? data.summary}
  noindex={data.status === "draft"}
>
  <Hero
    eyebrow={data.hero.eyebrow}
    title={data.hero.headline}
    subtitle={data.hero.subhead}
    primaryLabel={data.cta.label}
    primaryHref={data.cta.href ?? lp("/request-access")}
  />

  {
    data.valueProps.length > 0 && (
      <section class="container-page section">
        <header class="section__head">
          <p class="section__eyebrow">Why Lumii fits</p>
          <h2>Built around {data.audience.toLowerCase()}.</h2>
        </header>
        <div class="grid-3">
          {data.valueProps.map((vp) => (
            <FeatureBlock title={vp.title} body={vp.body} icon={vp.icon} />
          ))}
        </div>
      </section>
    )
  }

  {
    data.complianceNotes.length > 0 && (
      <section class="container-page compliance-section">
        <p class="section__eyebrow">Compliance</p>
        <div class="compliance">
          {data.complianceNotes.map((note) => (
            <Badge tone="green">{note}</Badge>
          ))}
        </div>
      </section>
    )
  }

  <section class="container-page prose measure">
    <Content />
  </section>

  <CTA
    title={t("cta.title")}
    body={t("cta.body")}
    buttonLabel={data.cta.label}
    buttonHref={data.cta.href ?? lp("/request-access")}
  />
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-section);
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46ch;
  }
  .section__eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-xl);
  }
  .compliance-section .section__eyebrow {
    margin-block-end: var(--space-md);
  }
  .compliance {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .prose {
    padding-block: var(--space-2xl);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
