---
/**
 * For Clinicians — audience page (§6). Speaks to the practitioner (vs the
 * practice owner): less admin, claim in the room, notes that write themselves.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import FeatureBlock from "@components/sections/FeatureBlock.astro";
import FAQ from "@components/sections/FAQ.astro";
import CTA from "@components/sections/CTA.astro";
import {
  useTranslations,
  localeFromPath,
  localizePath,
  localeStaticPaths,
} from "@i18n/index.ts";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);

const values = [
  {
    title: "Claim in the room",
    body: "Finish the appointment and raise the claim from the same screen — Tyro HealthPoint, Medicare, DVA and NDIS, with pre-flight checks that catch a rejection before you submit.",
    icon: "claim",
  },
  {
    title: "Notes that keep up",
    body: "AI-assisted clinical capture and letter drafting (bring your own clinic AI key) turn the consult into a structured note and correspondence without the after-hours typing.",
    icon: "notes",
  },
  {
    title: "Care plans track themselves",
    body: "Funded sessions burn down automatically as appointments complete — Medicare CDM, DVA, WorkCover and Private-Health Extras — so you always know what's left without counting on paper.",
    icon: "careplan",
  },
  {
    title: "Telehealth that just works",
    body: "Branded video consults with consent capture, a pre-visit form, screen share, and an AI scribe — bulk-billable and built into the same workflow, not bolted on.",
    icon: "telehealth",
  },
  {
    title: "Your whole day, one view",
    body: "A realtime appointment book that syncs live across Mac, iPad and the reception kiosk — patients check themselves in and the status flips to Arrived in front of you.",
    icon: "book",
  },
  {
    title: "Less front-desk friction",
    body: "Online booking, SMS reminders with one-tap confirm, and waitlist offers mean fewer no-shows and fewer interruptions between patients.",
    icon: "frontdesk",
  },
];

const faqs = [
  {
    q: "Does Lumii work on iPad?",
    a: "Yes — Lumii is a native app for macOS with compiled support for iPadOS and iPhone. The appointment book and kiosk are designed for live multi-device use.",
  },
  {
    q: "Do I need my own AI subscription for the clinical AI?",
    a: "The AI clinical-capture and letter features use your clinic's own OpenAI or Anthropic key — you stay in control of the model and the spend, and Lumii funds nothing on your behalf.",
  },
  {
    q: "Which disciplines is it built for?",
    a: "Lumii is multi-disciplinary — physio, OT, podiatry, psychology, GP and more. The claiming, care-plan and compliance workflows adapt to your discipline and funding mix.",
  },
];
---

<BaseLayout
  title="For clinicians"
  description="Lumii for clinicians: claim in the room, notes that keep up, care plans that track themselves, and a realtime book across Mac, iPad and the kiosk."
>
  <Hero
    eyebrow="For clinicians"
    title="Spend your day with patients, not admin."
    subtitle="Lumii does the busywork between consults — claiming, notes, care-plan tracking and reminders — so your time goes where it matters."
    primaryLabel={t("hero.ctaPrimary")}
    primaryHref={lp("/request-access")}
    secondaryLabel={t("hero.ctaSecondary")}
    secondaryHref={lp("/platform")}
  />

  <section class="container-page section">
    <header class="section__head">
      <p class="section__eyebrow">In the room</p>
      <h2>Less between you and the patient.</h2>
      <p class="section__lead measure">
        The busywork of a consult — claiming, notes, tracking, reminders — handled inside
        the workflow you're already in, not in three other tabs.
      </p>
    </header>
    <div class="grid-3">
      {values.map((v) => <FeatureBlock title={v.title} body={v.body} icon={v.icon} />)}
    </div>
  </section>

  <FAQ title="Common questions" items={faqs} />

  <CTA
    title={t("cta.title")}
    body={t("cta.body")}
    buttonLabel={t("cta.button")}
    buttonHref={lp("/request-access")}
  />
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-section);
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46ch;
  }
  .section__eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .section__lead {
    margin-block-start: var(--space-md);
    font-size: var(--text-lead);
    color: var(--text-secondary);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-xl);
  }
</style>
