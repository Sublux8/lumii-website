---
/**
 * Home — served at /en-au/ (default locale). Assembled from the section
 * components; the sector grid is data-driven from the `sectors` collection
 * (published only). Voice is warm + specific (the platinum bar set on the
 * platform page); the "why Lumii" benefit cards carry the human angle right
 * after the hero. Rich marketing copy lives inline as structured content
 * (single-locale, pre-launch); reusable chrome uses the i18n catalogue.
 */
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import FeatureBlock from "@components/sections/FeatureBlock.astro";
import LogoWall from "@components/sections/LogoWall.astro";
import CTA from "@components/sections/CTA.astro";
import FAQ from "@components/sections/FAQ.astro";
import {
  useTranslations,
  localeFromPath,
  localizePath,
  localeStaticPaths,
} from "@i18n/index.ts";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);

const sectors = (await getCollection("sectors"))
  .filter((s) => s.data.status === "published")
  .sort((a, b) => a.data.order - b.data.order);

const reasons = [
  {
    title: "Your whole day, one window",
    body: "Booking, notes, billing and claiming stop living in five systems. Open Lumii in the morning and the whole practice is just — there.",
    icon: "layers",
  },
  {
    title: "Made for Australian healthcare",
    body: "Tyro, Medicare, NDIS, DVA and the front-desk kiosk: the things a clinic here actually runs on, built in and already talking to each other.",
    icon: "au",
  },
  {
    title: "It does the fiddly bits",
    body: "Reminders that get confirmed, claims that don't bounce, a book that syncs the moment reception taps it — so your team can stay with people, not software.",
    icon: "spark",
  },
];

const faqs = [
  {
    q: "Where is patient data stored?",
    a: "In Australia. Lumii runs in Australian-region infrastructure, and the lead data captured on this site is stored in Sydney.",
  },
  {
    q: "Is Lumii available yet?",
    a: "Lumii is pre-launch. Join the early-access list and we'll be in touch personally as we onboard foundation clinics.",
  },
  {
    q: "Which disciplines does Lumii support?",
    a: "Lumii is multi-disciplinary — allied health and general practice today, with more sectors landing as we grow.",
  },
];
---

<BaseLayout>
  <Hero
    eyebrow={t("hero.eyebrow")}
    title={t("hero.title")}
    subtitle={t("hero.subtitle")}
    primaryLabel={t("hero.ctaPrimary")}
    primaryHref={lp("/request-access")}
    secondaryLabel={t("hero.ctaSecondary")}
    secondaryHref={lp("/platform")}
  />

  <section class="container-page section">
    <header class="section__head">
      <p class="section__eyebrow">Why Lumii</p>
      <h2>The practice that runs itself a little.</h2>
      <p class="section__lead measure">
        Not another tool to manage — a quieter, warmer way to run the day, built around
        how Australian clinics actually work.
      </p>
    </header>
    <div class="grid-3">
      {reasons.map((r) => <FeatureBlock title={r.title} body={r.body} icon={r.icon} />)}
    </div>
  </section>

  <section class="container-page section section--tight">
    <header class="section__head">
      <p class="section__eyebrow">Who it's for</p>
      <h2>{t("sectors.title")}</h2>
      <p class="section__lead measure">{t("sectors.subtitle")}</p>
    </header>
    <div class="grid-3">
      {
        sectors.map((s) => (
          <FeatureBlock title={s.data.audience} body={s.data.summary} icon={s.id} />
        ))
      }
    </div>
  </section>

  <LogoWall
    caption="Talks to the systems Australian clinics already trust"
    logos={[
      { name: "Tyro" },
      { name: "Medicare" },
      { name: "NDIS" },
      { name: "DVA" },
      { name: "Xero" },
    ]}
  />

  <FAQ title="The honest answers" items={faqs} />

  <CTA
    title={t("cta.title")}
    body={t("cta.body")}
    buttonLabel={t("cta.button")}
    buttonHref={lp("/request-access")}
  />
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-section);
  }
  .section--tight {
    padding-block-start: 0;
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46ch;
  }
  .section__eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .section__lead {
    margin-block-start: var(--space-md);
    font-size: var(--text-lead);
    color: var(--text-secondary);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-xl);
  }
</style>
