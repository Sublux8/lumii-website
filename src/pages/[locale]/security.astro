---
/**
 * Security & Compliance — real content (§6/§18). Page-body copy is inline (the
 * established pattern for marketing pages); shared chrome comes from i18n.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import FeatureBlock from "@components/sections/FeatureBlock.astro";
import Badge from "@components/primitives/Badge.astro";
import FAQ from "@components/sections/FAQ.astro";
import CTA from "@components/sections/CTA.astro";
import {
  useTranslations,
  localeFromPath,
  localizePath,
  localeStaticPaths,
} from "@i18n/index.ts";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);

const pillars = [
  {
    title: "Australian data residency",
    body: "Patient and clinic data lives in Australian-region infrastructure (Sydney). Enquiry details submitted through this site are stored in Australia too—no offshore round-trips.",
    icon: "au",
  },
  {
    title: "Encrypted in transit and at rest",
    body: "Information is encrypted while it moves and while it is stored across databases, files and backups. Sensitive service credentials are kept in managed secret storage, away from the applications people use.",
    icon: "lock",
  },
  {
    title: "Mandatory staff MFA",
    body: "TOTP multi-factor authentication is required for every staff role, with a trusted-device window and step-up re-auth for privileged actions. Patient MFA is available and can be made mandatory per clinic.",
    icon: "mfa",
  },
  {
    title: "Least-privilege access",
    body: "Role-based permissions limit each person to the information their work requires. Practice data is separated, and sensitive access is protected and auditable.",
    icon: "shield",
  },
  {
    title: "Daily backups",
    body: "Automated daily database exports to a dedicated per-project bucket, so a clinic's data is recoverable independent of day-to-day operations.",
    icon: "backup",
  },
  {
    title: "Defence in depth",
    body: "Public forms are protected against automated abuse, browser security protections are applied across the site, and a responsible-disclosure channel gives security researchers a clear way to contact us.",
    icon: "layers",
  },
  {
    title: "Consent-led patient sharing",
    body: "In myLumii, clinic connections are separate and revocable. Supported health categories are shared clinic by clinic only after explicit consent, while journal, food and personal exercise spaces remain private by design.",
    icon: "shield",
  },
];

const faqs = [
  {
    q: "Where is our data stored?",
    a: "In Australia—both production patient data and enquiry details submitted through this website. Lumii runs in the Sydney region across compute, database and storage.",
  },
  {
    q: "Is Lumii ISO 27001 certified?",
    a: "Lumii is not currently ISO 27001 certified. We are building our security management practices towards that standard, with access control, encryption, logging, backups and incident response already forming part of the platform's security approach.",
  },
  {
    q: "How do you handle the Australian Privacy Principles?",
    a: "Australian data residency, least-privilege access, audit logging, and a documented incident-response runbook underpin our APP alignment. Our privacy policy details collection, use, and disclosure.",
  },
  {
    q: "How do I report a vulnerability?",
    a: "Email security@lumii.com.au or see our security.txt. We welcome responsible disclosure.",
  },
  {
    q: "Can every connected clinic see everything in myLumii?",
    a: "No. Each clinic connection is kept separate, and supported health information is shared by category only when the individual chooses. Personal journal, food and exercise spaces do not include clinic sharing by design.",
  },
];
---

<BaseLayout
  title="Security & Compliance"
  description="How Lumii protects Australian clinic and patient data: Australian data residency, encryption, mandatory MFA, least-privilege access, daily backups, and defence in depth."
>
  <Hero
    eyebrow="Security & compliance"
    title="Security that earns a clinic's trust."
    subtitle="Lumii is built for Australian healthcare data — Australian residency, encryption everywhere, mandatory staff MFA, and least-privilege access by design."
    primaryLabel={t("hero.ctaPrimary")}
    primaryHref={lp("/request-access")}
  />

  <section class="container-page section">
    <div class="badges">
      <Badge tone="green">Australian data residency</Badge>
      <Badge tone="blue">Encrypted in transit &amp; at rest</Badge>
      <Badge tone="amber">Mandatory staff MFA</Badge>
      <Badge tone="purple">ISO 27001 / iRAP-readiness</Badge>
    </div>
    <header class="section__head">
      <p class="section__eyebrow">How we protect it</p>
      <h2>The protections healthcare should expect.</h2>
      <p class="section__lead measure">
        Australian residency, encryption, controlled access and recoverability are treated
        as foundations—not extras.
      </p>
    </header>
    <div class="grid-3">
      {pillars.map((p) => <FeatureBlock title={p.title} body={p.body} icon={p.icon} />)}
    </div>
  </section>

  <FAQ title="Security FAQ" items={faqs} />

  <section class="container-page disclosure measure">
    <p>
      Found a security issue? Email
      <a href="mailto:security@lumii.com.au">security@lumii.com.au</a> or see our
      <a href="/.well-known/security.txt">security.txt</a>. Read our
      <a href={lp("/privacy")}>privacy policy</a> for how we handle data.
    </p>
  </section>

  <CTA
    eyebrow="Security questions welcome"
    title="Trust should start before you sign up."
    body="Talk to us about your practice's privacy, security and governance requirements. We'll answer plainly and share the detail your team needs."
    buttonLabel={t("cta.button")}
    buttonHref={lp("/request-access")}
  />
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-section);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-end: var(--space-2xl);
  }
  .section__head {
    margin-block-end: var(--space-2xl);
    max-inline-size: 46ch;
  }
  .section__eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
  .section__head h2 {
    font-size: var(--text-h2);
  }
  .section__lead {
    margin-block-start: var(--space-md);
    font-size: var(--text-lead);
    color: var(--text-secondary);
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-xl);
  }
  .disclosure {
    padding-block: 0 var(--space-2xl);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
