---
import BaseLayout from "@layouts/BaseLayout.astro";
import PricingTable from "@components/sections/PricingTable.astro";
import {
  useTranslations,
  localeFromPath,
  localizePath,
  localeStaticPaths,
} from "@i18n/index.ts";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (p: string) => localizePath(p, locale);
const href = lp("/request-access");
---

<BaseLayout title={t("nav.pricing")}>
  <section class="container-page head">
    <p class="eyebrow">Pricing</p>
    <h1>Simple plans for practices and people.</h1>
    <p class="lead measure">
      Final pricing will be published before subscriptions open. Register your interest to
      tell us what you need and hear about the options that suit you, without any
      obligation.
    </p>
  </section>
  <PricingTable
    tiers={[
      {
        name: "myLumii",
        price: "—",
        cadence: "pricing soon",
        description:
          "For individuals who want their care, health information and personal insights in one private place.",
        features: [
          "Connect participating Lumii clinics",
          "Appointments, records, forms & messages",
          "Health data from supported sources",
          "Private journal, nutrition & exercise spaces",
          "Personal pattern insights",
          "Clinic-by-clinic sharing choices",
        ],
        ctaLabel: t("cta.button"),
        ctaHref: href,
      },
      {
        name: "Solo",
        price: "—",
        cadence: "pricing soon",
        description:
          "For independent practitioners who want a complete clinical and practice-management home.",
        features: [
          "1 practitioner",
          "2 locations",
          "Unlimited patients",
          "Online booking portal",
          "SMS & email reminders",
          "Clinical notes & treatment plans",
          "GST invoicing",
          "Tyro health-fund claiming",
          "Data import & export",
        ],
        ctaLabel: t("cta.button"),
        ctaHref: href,
      },
      {
        name: "Clinic",
        price: "—",
        cadence: "pricing soon",
        description:
          "For multidisciplinary practices, specialist rooms and growing clinic groups.",
        features: [
          "Everything in Solo, plus:",
          "Unlimited practitioners",
          "Unlimited locations",
          "Multi-practitioner rosters",
          "Treatment-plan tracking",
          "DVA, Medicare, NDIS & WorkCover",
          "Xero & Mailchimp integration",
          "Advanced reports",
          "Priority support",
        ],
        ctaLabel: t("cta.button"),
        ctaHref: href,
        featured: true,
        badge: "Recommended",
      },
    ]}
  />
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-section) 0;
  }
  .eyebrow {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
  .lead {
    margin-block-start: var(--space-md);
    font-size: var(--text-lead);
    color: var(--text-secondary);
  }
</style>
