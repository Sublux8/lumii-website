---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/primitives/Button.astro";
import { useTranslations, localeFromPath, localizePath } from "@i18n/index.ts";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<BaseLayout title={t("error.404.title")} noindex={true}>
  <section class="container-page notfound">
    <p class="notfound__code">404</p>
    <h1>{t("error.404.title")}</h1>
    <p class="notfound__body measure">{t("error.404.body")}</p>
    <Button href={localizePath("/", locale)} size="lg">{t("error.404.home")}</Button>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-6xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }
  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-display-1);
    font-weight: var(--weight-bold);
    color: var(--accent);
  }
  .notfound__body {
    color: var(--text-secondary);
    margin-block-end: var(--space-lg);
  }
</style>
