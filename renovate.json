{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "timezone": "Australia/Sydney",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Group the Astro toolchain so its peer versions move together.",
      "matchPackageNames": [
        "astro",
        "@astrojs/mdx",
        "@astrojs/sitemap",
        "@astrojs/cloudflare",
        "@astrojs/check"
      ],
      "groupName": "astro"
    },
    {
      "description": "Group Tailwind packages.",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/postcss", "@tailwindcss/vite"],
      "groupName": "tailwind"
    },
    {
      "description": "Auto-merge safe dev-dependency patch/minor bumps.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"] }
}
